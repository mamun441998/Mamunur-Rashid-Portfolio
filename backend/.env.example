# Backend environment — copy to backend/.env and fill with real values.
# NEVER commit the real .env (it is git-ignored).

# Supabase Postgres pooler connection string.
# Note: URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# JWT signing
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin bootstrap credentials (used to create/refresh the admin on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SMTP (Gmail app password recommended) for contact alerts + replies
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=your-gmail-app-password
NOTIFICATION_EMAIL=you@example.com

# Comma-separated allowed origins (Vercel domain(s) + localhost)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Calendly (optional) — signing key verifies webhooks; access token unused for now
CALENDLY_SIGNING_KEY=
CALENDLY_ACCESS_TOKEN=

# Production email via Brevo HTTP API (recommended on Render, which blocks SMTP).
# Create a free account at https://www.brevo.com, verify SMTP_EMAIL as a sender, paste the key here and in Render.
BREVO_API_KEY=

# Google Calendar secret iCal feed for the admin Meetings Panel.
# Google Calendar -> Settings -> <your calendar> -> "Secret address in iCal format" -> copy the URL.
GOOGLE_CALENDAR_ICAL_URL=
